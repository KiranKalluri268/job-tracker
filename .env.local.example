# MongoDB Atlas — Database > Connect > Drivers, then swap in your DB user's password
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="jobtracker"

# Generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Two comma-separated allowlists of Google accounts. ADMIN_EMAILS can read and
# edit; VIEW_EMAILS can only read (the UI hides every edit control and the write
# API routes return 403). An address on neither list cannot sign in. Edit these in
# Vercel's Settings > Environment Variables and redeploy — no code change needed.
# ALLOWED_EMAILS is still honoured as an admin list if ADMIN_EMAILS is unset.
ADMIN_EMAILS="kirankalluri888@gmail.com"
VIEW_EMAILS="viewer@example.com"

# Bearer token for the LinkedIn job-search automation's POST /api/applications/ingest.
# Generate any long random string; it just has to match on both ends.
INGEST_API_TOKEN=""
